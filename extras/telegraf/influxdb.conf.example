# /etc/telegraf/telegraf.d/influxdb.conf - InfluxDB v2 output
# The token comes from /etc/default/telegraf (INFLUX_TOKEN=...), mode 640 root:telegraf,
# so it never sits in a config file that gets copied around.
[[outputs.influxdb_v2]]
  urls = ["http://<influxdb-host>:8086"]     # Tailscale IP/name of the InfluxDB server
  token = "${INFLUX_TOKEN}"
  organization = "<org>"
  bucket = "<server-name>"                   # one bucket per server

# Quieter disk input: do NOT add a second [[inputs.disk]] here (metrics would be doubled).
# Instead edit the existing one in /etc/telegraf/telegraf.conf:
#   ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs", "nsfs", "fuse.portal", "fuse.gvfsd-fuse"]
